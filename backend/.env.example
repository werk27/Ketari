# Copy this file to backend/.env and fill in real values.
#   PowerShell:  Copy-Item .env.example .env
# backend/.env is git-ignored and must be created on every machine.

PORT=5000

# Which database the backend uses. Always an explicit choice - the server
# never falls back to the other one, because silently using the wrong database
# rejects valid logins with "Invalid email or password" while /api/health still
# reports "connected".
#   local  MongoDB on this machine, the primary working database
#   atlas  the MongoDB Atlas backup copy
DB_TARGET=local

# Primary working database on this machine.
# Requires a running mongod:  net start MongoDB
MONGODB_URI_LOCAL=mongodb://127.0.0.1:27017/ketari_local

# Backup copy in MongoDB Atlas.
# Atlas: Cluster -> Connect -> Drivers -> copy the string, then replace
# <username>/<password> and put your database name after the host.
# URL-encode special characters in the password: @ must be written %40.
MONGODB_URI_ATLAS=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=Cluster0

# Copy data between the two:
#   npm run db:status   show both without changing anything
#   npm run db:backup   local -> atlas, refresh the backup
#   npm run db:pull     atlas -> local, restore or seed this machine

# Copy the local database to the Atlas backup automatically while the server
# runs. Only applies when DB_TARGET=local, and needs MONGODB_URI_ATLAS.
# The result is appended to backend/backups/backup-log.txt.
AUTO_BACKUP=true
AUTO_BACKUP_INTERVAL_HOURS=24

# Secret used to sign JWTs. Use a long random value, unique per environment.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=30d

NODE_ENV=development

# Optional rate limiting. Both are per 15 minute window.
#   RATE_LIMIT_MAX         - general API budget per IP.
#                            Default: 1000 in production, 5000 otherwise.
#   AUTH_RATE_LIMIT_MAX    - failed sign-in attempts per account per IP (default 30).
#                            Successful sign-ins are never counted.
#   ACCOUNT_RATE_LIMIT_MAX - registrations + password reset requests per IP (default 20).
# Raise these only if legitimate traffic is being rejected with HTTP 429.
#RATE_LIMIT_MAX=1000
#AUTH_RATE_LIMIT_MAX=30
#ACCOUNT_RATE_LIMIT_MAX=20

# Optional. Extra browser origins allowed to call the API, comma separated.
# http://localhost:3000 and :3001 are always allowed, and outside production any
# localhost port is accepted so a frontend on 3002 still works.
#CORS_ORIGINS=https://app.example.com
